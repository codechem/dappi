{
  "name": "dappi-query",
  "version": "0.1.0",
  "description": "Fluent query-string builder for Dappi headless CMS APIs (filtering, sorting, pagination, search and field shaping).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "dappi",
    "query",
    "query-builder",
    "querystring",
    "headless-cms",
    "filter",
    "pagination"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
